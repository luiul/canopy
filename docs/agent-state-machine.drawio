<mxCell id="end_outer" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="940" y="320" width="26" height="26" as="geometry" /></mxCell>
<mxCell id="end_inner" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="948" y="328" width="10" height="10" as="geometry" /></mxCell>
<mxCell id="note" value="Sticky: only key_enter or key_c may leave this state. cpu_idle, cpu_working (a fresh working turn), a fresh poll — every other automatic signal is ignored while a row is displaying done." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;fontSize=12;size=14;" vertex="1" parent="1"><mxGeometry x="560" y="600" width="280" height="130" as="geometry" /></mxCell>
<mxCell id="e0" value="discovered" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=12;" edge="1" parent="1" source="start" target="unknown"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e1" value="cpu_working / pi_working" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=12;" edge="1" parent="1" source="unknown" target="working"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2" value="cpu_idle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=12;" edge="1" parent="1" source="unknown" target="idle"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e3" value="cpu_working / pi_working" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=12;exitY=0.3;entryY=0.3;" edge="1" parent="1" source="idle" target="working"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e4" value="cpu_idle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=12;exitY=0.7;entryY=0.7;" edge="1" parent="1" source="working" target="idle"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e5" value="pi_settled" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=12;" edge="1" parent="1" source="working" target="done"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e6" value="key_enter (jump to window)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=12;exitY=0.3;entryY=0.25;" edge="1" parent="1" source="done" target="idle"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e7" value="key_c (mark complete)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=12;exitY=0.7;entryY=0.75;" edge="1" parent="1" source="done" target="idle"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e8" value="miss_exceeded" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=12;" edge="1" parent="1" source="tracked" target="end_outer"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e_note" value="" style="edgeStyle=none;html=1;dashed=1;endArrow=none;startArrow=none;" edge="1" parent="1" source="note" target="done"><mxGeometry relative="1" as="geometry" /></mxCell>
