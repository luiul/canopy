<mxCell id="title" value="canopy — agent state machine (per-row display state)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry" /></mxCell>
