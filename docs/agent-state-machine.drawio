<mxfile host="app.diagrams.net">
  <diagram name="Agent State Machine" id="canopy-agent-state-machine">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1006" pageHeight="770" math="0" shadow="0">
      <root>
        <mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="tracked" value="Tracked" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontSize=13;fontStyle=2;fontColor=#666666;strokeColor=#999999;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="760" height="480" as="geometry" /></mxCell>
<mxCell id="title" value="canopy — agent state machine (per-row display state)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="760" height="30" as="geometry" /></mxCell>
<mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="405" y="55" width="30" height="30" as="geometry" /></mxCell>
<mxCell id="unknown" value="unknown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="340" y="160" width="160" height="70" as="geometry" /></mxCell>
<mxCell id="idle" value="idle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="140" y="300" width="160" height="70" as="geometry" /></mxCell>
<mxCell id="working" value="working" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="540" y="300" width="160" height="70" as="geometry" /></mxCell>
